{
  "name": "mystery-school",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "vite": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "marked": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.lycheetah.mysteryschool",
    "productName": "The Mystery School",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "engine/**/*",
      "data/**/*",
      "curriculum/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "mac": {
      "target": "dmg"
    }
  },
  "private": true
}
